function getEmployeeList(token) {
  try {
    requireAdmin(token);
    
    const data = getSheetData(SHEETS.EMPLOYEE);
    const employees = [];
    
    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      employees.push({
        employeeId: row[EMPLOYEE_COLS.EMPLOYEE_ID],
        name: row[EMPLOYEE_COLS.NAME],
        role: row[EMPLOYEE_COLS.ROLE],
        department: row[EMPLOYEE_COLS.DEPARTMENT],
        status: row[EMPLOYEE_COLS.STATUS]
      });
    }
    
    return {
      success: true,
      employees: employees
    };
  } catch (error) {
    return {
      success: false,
      message: error.message
    };
  }
}
