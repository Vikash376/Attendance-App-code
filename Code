// ============================================
// CONSTANTS & CONFIGURATION
// ============================================

const SHEETS = {
  EMPLOYEE: 'EMPLOYEE',
  LOCATIONS: 'LOCATIONS',
  COMPANY_SETTINGS: 'COMPANY_SETTINGS',
  ATTENDANCE: 'ATTENDANCE',
  PUNCH_DETAILS: 'PUNCH_DETAILS',
  LEAVE_HOLIDAY: 'LEAVE_HOLIDAY',
  LEAVE_BALANCE: 'LEAVE_BALANCE',
  NORMALIZATION: 'NORMALIZATION',
  DASHBOARD: 'DASHBOARD'
};

// Column indices for EMPLOYEE sheet (0-based)
const EMPLOYEE_COLS = {
  EMPLOYEE_ID: 0,
  NAME: 1,
  ROLE: 2,
  DEPARTMENT: 3,
  EMAIL: 4,
  PHONE: 5,
  SHIFT_START: 6,
  SHIFT_END: 7,
  LUNCH_ALLOWED: 8,
  GRACE: 9,
  WEEKLY_OFF: 10,
  ASSIGNED_LOCATION_ID: 11,
  PHOTO_URL: 12,
  STATUS: 13,
  PIN: 14
};

// ============================================
// SESSION MANAGEMENT - Using PropertiesService for reliability
// ============================================

function createSession(employeeId, name, role) {
  try {
    const token = Utilities.getUuid();
    const sessionData = {
      employeeId: employeeId,
      name: name,
      role: role,
      loginTime: new Date().toISOString()
    };
    
    // Store in both Cache and Properties for reliability
    const cache = CacheService.getScriptCache();
    cache.put(token, JSON.stringify(sessionData), 21600); // 6 hours
    
    // Also store in Properties as backup
    const props = PropertiesService.getScriptProperties();
    props.setProperty('session_' + token, JSON.stringify(sessionData));
    
    return token;
  } catch (error) {
    console.error('Error creating session:', error);
    throw error;
  }
}

function validateSession(token) {
  if (!token) {
    return null;
  }
  
  try {
    // Try Cache first
    const cache = CacheService.getScriptCache();
    let sessionData = cache.get(token);
    
    // If not in cache, try Properties
    if (!sessionData) {
      const props = PropertiesService.getScriptProperties();
      sessionData = props.getProperty('session_' + token);
    }
    
    if (!sessionData) {
      return null;
    }
    
    return JSON.parse(sessionData);
  } catch (error) {
    console.error('Error validating session:', error);
    return null;
  }
}

function destroySession(token) {
  try {
    const cache = CacheService.getScriptCache();
    cache.remove(token);
    
    const props = PropertiesService.getScriptProperties();
    props.deleteProperty('session_' + token);
    
    return { success: true };
  } catch (error) {
    console.error('Error destroying session:', error);
    return { success: false, message: error.message };
  }
}

// ============================================
// PERMISSION GUARDS
// ============================================

function requireAdmin(token) {
  const session = validateSession(token);
  if (!session) {
    throw new Error('Session expired or invalid');
  }
  if (session.role !== 'Admin') {
    throw new Error('Admin access required');
  }
  return session;
}

function requireEmployee(token) {
  const session = validateSession(token);
  if (!session) {
    throw new Error('Session expired or invalid');
  }
  if (session.role !== 'Employee') {
    throw new Error('Employee access required');
  }
  return session;
}

// ============================================
// SHEET HELPERS
// ============================================

function getSpreadsheet() {
  try {
    return SpreadsheetApp.getActiveSpreadsheet();
  } catch (error) {
    console.error('Error getting spreadsheet:', error);
    throw new Error('Could not access spreadsheet');
  }
}

function getSheetData(sheetName) {
  try {
    const sheet = getSpreadsheet().getSheetByName(sheetName);
    if (!sheet) {
      throw new Error(`Sheet "${sheetName}" not found`);
    }
    return sheet.getDataRange().getValues();
  } catch (error) {
    console.error(`Error reading sheet "${sheetName}":`, error);
    throw error;
  }
}

function getCompanySettings() {
  try {
    const data = getSheetData(SHEETS.COMPANY_SETTINGS);
    const settings = {};
    for (let i = 1; i < data.length; i++) {
      if (data[i][0]) {
        settings[data[i][0]] = data[i][1] || '';
      }
    }
    return settings;
  } catch (error) {
    console.error('Error getting company settings:', error);
    return {};
  }
}

function getEmployeeData(employeeId) {
  try {
    const data = getSheetData(SHEETS.EMPLOYEE);
    if (data.length < 2) return null;
    
    for (let i = 1; i < data.length; i++) {
      const currentId = data[i][EMPLOYEE_COLS.EMPLOYEE_ID] ? data[i][EMPLOYEE_COLS.EMPLOYEE_ID].toString().trim() : '';
      if (currentId === employeeId) {
        return {
          rowIndex: i,
          data: data[i],
          name: data[i][EMPLOYEE_COLS.NAME] || '',
          role: data[i][EMPLOYEE_COLS.ROLE] || 'Employee',
          status: data[i][EMPLOYEE_COLS.STATUS] || ''
        };
      }
    }
    return null;
  } catch (error) {
    console.error('Error getting employee data:', error);
    return null;
  }
}

// ============================================
// LOGIN FUNCTIONS
// ============================================

function verifyLogin(employeeId, pin) {
  try {
    // Validate inputs
    if (!employeeId || !pin) {
      return {
        success: false,
        message: 'Employee ID and PIN are required'
      };
    }

    const trimmedEmployeeId = employeeId.trim();
    const trimmedPin = pin.trim();

    // Get employee data
    const employee = getEmployeeData(trimmedEmployeeId);
    
    if (!employee) {
      return {
        success: false,
        message: 'Employee ID not found'
      };
    }

    // Get PIN from column 14
    const storedPin = employee.data[14] ? employee.data[14].toString().trim() : '';
    
    if (storedPin !== trimmedPin) {
      return {
        success: false,
        message: 'Invalid PIN'
      };
    }

    // Check status
    if (employee.status.toLowerCase() === 'inactive') {
      return {
        success: false,
        message: 'Account is inactive. Please contact HR.'
      };
    }

    // Create session
    const token = createSession(trimmedEmployeeId, employee.name, employee.role);

    // Get company settings
    const settings = getCompanySettings();

    return {
      success: true,
      token: token,
      name: employee.name,
      role: employee.role,
      employeeId: trimmedEmployeeId,
      companyName: settings['Company Name'] || 'Company',
      companyLogo: settings['Company Logo URL'] || ''
    };

  } catch (error) {
    console.error('Login error:', error);
    return {
      success: false,
      message: 'Login failed: ' + error.message
    };
  }
}

function logout(token) {
  return destroySession(token);
}

function getSessionData(token) {
  try {
    const session = validateSession(token);
    if (!session) {
      return {
        success: false,
        message: 'Session expired'
      };
    }
    
    const settings = getCompanySettings();
    
    return {
      success: true,
      name: session.name,
      role: session.role,
      employeeId: session.employeeId,
      companyName: settings['Company Name'] || 'Company',
      companyLogo: settings['Company Logo URL'] || ''
    };
  } catch (error) {
    console.error('Session verification error:', error);
    return {
      success: false,
      message: error.message
    };
  }
}

